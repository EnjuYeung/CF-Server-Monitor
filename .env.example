# Copy to .env. Use your own random value; this is also the initial admin password.
API_SECRET=replace-with-a-long-random-secret
API_USER_NAME=admin
# Required secret admin entry, 8–128 random letters/digits/_/-, optional leading slash.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(18).toString('base64url'))"
# Visit https://your-domain/<ADMIN_PATH>. Never reuse API_SECRET here.
ADMIN_PATH=
HOST_PORT=8080
BIND_ADDRESS=127.0.0.1
DATA_PATH=./data
# Exact reverse proxy IPs/CIDRs. Empty means ignore all forwarded headers.
# A proxy on the host connects from the Docker bridge gateway, not 127.0.0.1.
TRUSTED_PROXIES=
# Optional public VPS IP for same-host agents when automatic egress discovery is unavailable.
PUBLIC_IP=
CORS_ALLOWED_ORIGINS=
# Keep versioned Agent binaries in data/agent-releases across controller upgrades.
AGENT_ARCHIVE_ENABLED=true
